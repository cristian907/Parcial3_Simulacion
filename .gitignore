# ==============================================================================
# .gitignore para Proyecto Independiente: Parcial III Simulación (UJAP)
# ==============================================================================

# Entornos virtuales de Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode y caches de compilación de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Variables de entorno y credenciales (mantener .env.example público)
.env
.env.local
.env.*.local
!.env.example

# IDEs, editores y herramientas de desarrollo
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.directory

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs y depuración
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Pruebas y cobertura de código
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Pygame y librerías multimedia
.pygame_sdl2/

